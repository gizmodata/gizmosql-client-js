{
  "name": "@gizmodata/gizmosql-client",
  "version": "2.2.2",
  "description": "A TypeScript/JavaScript client for GizmoSQL and Apache Arrow Flight SQL",
  "author": "GizmoData LLC",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gizmodata/gizmosql-client-js.git"
  },
  "homepage": "https://github.com/gizmodata/gizmosql-client-js#readme",
  "bugs": {
    "url": "https://github.com/gizmodata/gizmosql-client-js/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/",
    "scripts/",
    "driver-manifest.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist/",
    "postinstall": "node scripts/download-driver.cjs",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.unit.config.js --testPathIgnorePatterns=integration",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.unit.config.js --testPathIgnorePatterns=integration",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=integration",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.unit.config.js --watch --testPathIgnorePatterns=integration",
    "lint": "eslint src test --fix",
    "lint:ci": "eslint src test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test && npm run lint:ci"
  },
  "keywords": [
    "gizmosql",
    "gizmodata",
    "arrow",
    "flight",
    "flightsql",
    "apache-arrow",
    "grpc",
    "sql",
    "database",
    "analytics",
    "duckdb"
  ],
  "dependencies": {
    "@apache-arrow/adbc-driver-manager": "^0.24.0",
    "apache-arrow": "^21.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.3",
    "eslint": "^10.9.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-unicorn": "^74.0.0",
    "jest": "^30.5.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "test-exclude": "^7.0.1"
  }
}
